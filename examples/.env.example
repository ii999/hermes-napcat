# Add to the chosen Hermes profile's .env. Do not commit real credentials.
# Generate a token with: uv run --no-project python -c "import secrets; print(secrets.token_urlsafe(32))"
NAPCAT_TOKEN=replace-with-a-generated-random-token
NAPCAT_ALLOWED_USERS=111111111
NAPCAT_ALLOW_ALL_USERS=false
NAPCAT_HOME_CHANNEL=private:111111111
